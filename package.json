{
  "name": "interlude-launcher",
  "productName": "HDS-Interlude Launcher",
  "version": "1.3.0",
  "private": true,
  "description": "Koishi、SnowLuma 与 QQ 桌面启动器",
  "main": "src/main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/core.test.cjs tests/setup.test.cjs tests/official.test.cjs tests/update.test.cjs",
    "test:desktop": "node tests/desktop.cjs && node tests/setup-desktop.cjs && node tests/about-desktop.cjs",
    "package": "node scripts/package.cjs",
    "release:assets": "node scripts/release.cjs",
    "test:updater": "node tests/updater-desktop.cjs"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "electron": "44.5.1",
    "prettier": "3.8.3",
    "rcedit": "5.0.2"
  },
  "dependencies": {
    "cheerio": "1.2.0",
    "semver": "7.8.5",
    "tar": "7.5.22",
    "yaml": "2.9.1",
    "yauzl": "3.4.0"
  },
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/Reversed-Future/HDS-Interlude-Launcher.git"
  },
  "homepage": "https://github.com/Reversed-Future/HDS-Interlude-Launcher",
  "bugs": {
    "url": "https://github.com/Reversed-Future/HDS-Interlude-Launcher/issues"
  }
